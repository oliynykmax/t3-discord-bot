# Non-secret config, read with podman --env-file (no inline comments allowed).
# Secrets (DISCORD_TOKEN, GH_APP_PRIVATE_KEY, COPILOT_GITHUB_TOKEN) live in the keychain via fnox, see fnox.toml.

# Comma-separated Discord user ids (and/or role ids) allowed to command the bot. Empty means nobody.
ALLOWED_USER_IDS=
ALLOWED_ROLE_IDS=
# Optional: only react in these channel ids.
CHANNEL_IDS=
# Default channel id for the agents' `say` command.
POST_CHANNEL_ID=
# T3 project title or id the bot works in.
PROJECT=
DEFAULT_MODEL=claudeAgent/claude-sonnet-5-5
BASE_REF=main
START_FROM_ORIGIN=false
GH_APP_ID=
GH_INSTALLATION_ID=
BOT_GIT_NAME=my-bot[bot]
BOT_GIT_EMAIL=<app-user-id>+my-bot[bot]@users.noreply.github.com
# Extra directories agents may attach files from (comma-separated).
ATTACH_EXTRA_ROOTS=
# PREAMBLE=instructions prepended to every new conversation (default in bot/index.ts)
